"_note": "Requirements are representative of typical public postings for these roles (not copied verbatim, not live listings). Edit weights/skills freely and verify against each company's careers page before relying on them. Company fields: n=name, c=HQ country, s=sector, r=role archetypes hired, i=1 if it has major India offices, al=extra names used by the chatbot.",
"skills": {
"python": {"a": ["python"], "p": "Build a CLI expense tracker in Python with file storage, argparse, and pytest tests."},
"java": {"a": ["java"], "p": "Build a library-management console app in Java with OOP design and JUnit tests."},
"javascript": {"a": ["javascript", "js", "es6"], "p": "Build a to-do app in vanilla JavaScript with fetch calls to a public API."},
"typescript": {"a": ["typescript"], "p": "Port a small JavaScript project to TypeScript with strict mode enabled."},
"react": {"a": ["react", "reactjs", "react.js"], "p": "Build a weather dashboard in React with hooks, routing and API data."},
"html/css": {"a": ["html", "css", "tailwind", "bootstrap"], "p": "Build a responsive portfolio page with CSS grid/flexbox and accessible markup."},
"node.js": {"a": ["node", "nodejs", "node.js", "express"], "p": "Build a REST API in Node/Express with JWT login and input validation."},
"rest api": {"a": ["rest", "restful", "api", "flask", "django", "fastapi"], "p": "Build a documented REST API (Flask/FastAPI) with CRUD, auth and automated tests."},
"sql": {"a": ["sql", "mysql", "postgresql", "postgres", "sqlite"], "p": "Design a normalized database for a school system and write 15 analytical queries."},
"git": {"a": ["git", "github", "gitlab"], "p": "Contribute a documented pull request to an open-source repo and keep a clean commit history."},
"data structures": {"a": ["data structures", "dsa", "linked list", "hash map", "trees"], "p": "Implement stack, queue, hash map and BST from scratch with unit tests."},
"algorithms": {"a": ["algorithms", "leetcode", "dynamic programming", "sorting"], "p": "Solve and document 30 graded problems, with complexity analysis in a README."},
"docker": {"a": ["docker", "containers", "kubernetes"], "p": "Containerize a Flask + database app with docker-compose and a Dockerfile."},
"aws": {"a": ["aws", "azure", "gcp", "cloud", "ec2", "s3"], "p": "Deploy a static site and API to AWS (S3 + Lambda or EC2) and document the setup."},
"ci/cd": {"a": ["ci/cd", "github actions", "jenkins", "pipeline"], "p": "Add a GitHub Actions pipeline that lints, tests and builds an existing project."},
"testing": {"a": ["testing", "pytest", "junit", "jest", "unit test"], "p": "Add unit tests reaching 80% coverage to one of your existing projects."},
"linux": {"a": ["linux", "bash", "shell", "ubuntu"], "p": "Write 5 bash automation scripts (backup, log parsing, deploy) and document them."},
"pandas": {"a": ["pandas", "numpy", "data cleaning"], "p": "Clean a messy public dataset with pandas and publish a reproducible notebook."},
"statistics": {"a": ["statistics", "hypothesis testing", "regression", "probability"], "p": "Run an A/B test analysis on a public dataset with confidence intervals."},
"data visualization": {"a": ["tableau", "power bi", "matplotlib", "seaborn", "plotly", "dashboard"], "p": "Build a dashboard telling one clear story from a public dataset."},
"machine learning": {"a": ["machine learning", "scikit-learn", "sklearn", "tensorflow", "pytorch", "ml"], "p": "Train and evaluate a classifier on a public dataset with proper train/test split and metrics."},
"c/c++": {"a": ["c++", "c programming", "embedded c"], "p": "Implement a small memory allocator or linked-list library in C/C++ with unit tests and a README."},
"embedded": {"a": ["embedded", "microcontroller", "arduino", "raspberry pi", "rtos", "firmware", "iot"], "p": "Build a sensor-based IoT project on Arduino or Raspberry Pi that logs data and shows it on a simple dashboard."},
"networking": {"a": ["networking", "tcp/ip", "tcp", "dns", "wireshark", "routing"], "p": "Capture traffic with Wireshark and write up how one web request flows through DNS, TCP and HTTP."},
"cybersecurity": {"a": ["cybersecurity", "cyber security", "security", "penetration testing", "owasp", "ethical hacking", "ctf", "infosec"], "p": "Complete 10 OWASP Top-10 labs (Juice Shop or TryHackMe) and publish a write-up of each exploit and its fix."},
"mobile": {"a": ["android", "kotlin", "flutter", "swift", "ios", "react native", "mobile"], "p": "Build a small Android (Kotlin) or Flutter app that consumes a public API and stores data locally."},
"excel": {"a": ["excel", "spreadsheet", "google sheets", "vlookup", "pivot"], "p": "Build an Excel dashboard with pivot tables, lookups and charts from a public dataset and document your insights."}
},
